# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+491234567890

# AI Provider Configuration
# Choose: "anthropic" or "openai"
AI_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Speech-to-Text (optional, falls nicht Twilio verwendet)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Text-to-Speech (optional, falls nicht Twilio verwendet)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (EN) - wähle eine deutsche Stimme

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PUBLIC_URL=https://your-domain.com  # Für Twilio Webhooks (ngrok in Development)

# Database
DATABASE_URL=sqlite:///./data/candidates.db

# Company/Recruiting Information
COMPANY_NAME=Ihr Unternehmen GmbH
COMPANY_DESCRIPTION=Führender Hörakustik-Anbieter mit 50+ Filialen
JOB_BENEFITS=Attraktives Gehalt, Firmenwagen, Weiterbildung, flexible Arbeitszeiten
CONTACT_EMAIL=recruiting@ihre-firma.de
CONTACT_PHONE=+49123456789

# Conversation Settings
DEFAULT_LANGUAGE=de-DE
MAX_CONVERSATION_TURNS=20
CALL_TIMEOUT_SECONDS=600

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
