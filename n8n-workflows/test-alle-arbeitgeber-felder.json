      "credentials": {
        "notionApi": {
          "id": "0XxuLBeEBkLiPVOR",
          "name": "Notion Kandidaten"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const properties = $input.first().json.properties || {};\nconst arbeitgeberProps = [];\n\nfor (const [name, config] of Object.entries(properties)) {\n  if (name.toLowerCase().includes('arbeitgeber') || name.toLowerCase().includes('distanz')) {\n    arbeitgeberProps.push({\n      display_name: name,\n      type: config.type,\n      is_relation: config.type === 'relation',\n      config: JSON.stringify(config, null, 2)\n    });\n  }\n}\n\nreturn arbeitgeberProps.map(p => ({ json: p }));"
      },
      "id": "extract-props",
      "name": "Arbeitgeber & Distanz Felder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Start": {
      "main": [[{"node": "Database Schema holen", "type": "main", "index": 0}]]
    },
    "Database Schema holen": {
      "main": [[{"node": "Arbeitgeber & Distanz Felder", "type": "main", "index": 0}]]
    }
